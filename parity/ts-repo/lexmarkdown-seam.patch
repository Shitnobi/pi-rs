+/**
+ * Test seam for the Rust port's marked-lexer differential: the exact token
+ * stream `render()` produces for a source string (tab normalization +
+ * `markdownParser.lexer` + `trimPartialClosingFences`). Not used by the
+ * renderer itself — `render()` inlines the same pipeline.
+ */
+export function lexMarkdown(source: string): Token[] {
+	const normalized = source.replace(/\t/g, "   ");
+	const tokens = markdownParser.lexer(normalized);
+	trimPartialClosingFences(tokens);
+	return tokens;
+}
